{
  "_说明": "单条 eval = 一个真实任务 + 一组'算通过'的检查项。20-50 条为一套，由平台工程师从近期真实工作里捞。",
  "name": "示例：给接口加边界校验",
  "prompt": "给 <服务/接口> 增加参数边界校验，超出范围返回 400，不要改动现有成功路径的行为。",
  "checks": [
    { "type": "command_succeeds", "value": "make test", "_说明": "既有测试仍然全绿（行为不变）" },
    { "type": "command_succeeds", "value": "make lint", "_说明": "代码风格不漂移" },
    { "type": "file_contains", "path": "<被测文件>", "value": "400", "_说明": "确实加了边界拒绝" },
    { "type": "policy_followed", "value": "<策略名，例如：不得引入新依赖>", "_说明": "遵循了组织策略" }
  ],
  "_沉淀提示": "每次生产事故，都沉淀成一个永久 eval——下次同样的退化在合并前就被拦下，而不是等线上炸了才发现。"
}
